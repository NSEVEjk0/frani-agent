# ─────────────────────────────────────────────────────────────
#  frani-agent — example configuration
#  Copy to .env and edit. EVERY value has a safe default, so an
#  empty/absent .env runs a valid testnet2 agent out of the box.
#  (.env is gitignored — never commit real secrets.)
#  Made by CRYPTFRANI · Owner: Itachi
# ─────────────────────────────────────────────────────────────

# ── Core identity & network ──────────────────────────────────
# The nametag the agent claims (without the leading '@').
AGENT_NAME=frani-agent
# Unicity network to run against.
UNICITY_NETWORK=testnet2

# ── Paid tasks ────────────────────────────────────────────────
# Price in UCT for each paid DM task (notarize / digest).
NOTARIZE_FEE_UCT=5

# ─────────────────────────────────────────────────────────────
#  Optional advanced settings (defaults shown) — safe to omit
# ─────────────────────────────────────────────────────────────

# ── Wallet storage / security ─────────────────────────────────
# WALLET_DIR=./wallet-data
# WALLET_FILE=wallet.json
# Encrypt the mnemonic at rest (recommended on a shared host). Empty = plaintext.
# WALLET_PASSWORD=

# ── Network endpoints (rarely changed) ────────────────────────
# COIN_SYMBOL=UCT
# WALLET_API_URL=https://wallet-api.unicity.network
# Public testnet2 oracle/aggregator key (NOT a secret; safe default baked in).
# ORACLE_API_KEY=

# ── Loop cadence (ms) — gentle by design for a shared VPS ─────
# FEED_POLL_MS=60000
# SEARCH_POLL_MS=90000
# RECEIVE_POLL_MS=45000

# ── Economic safety rails ─────────────────────────────────────
# Global kill-switch: log intended actions but never touch the network/funds.
# DRY_RUN=false
# Whole-UCT floor the agent will never spend below.
# MIN_BALANCE=1
# One-time capped self-mint on first run (no faucet on testnet2).
# SELF_MINT_ENABLED=true
# SELF_MINT_AMOUNT=100
# Earn-only policy: the ONLY autonomous outbound payment is refunding overpayment.
# AUTO_REFUND_OVERPAYMENT=true
# Politeness / anti-spam.
# MATCH_MIN_SCORE=0.72
# MAX_DMS_PER_HOUR=20
# MAX_ACTIONS_PER_HOUR=60

# ── Concierge (matchmaker) ────────────────────────────────────
# SERVICE_DESCRIPTION=Autonomous market concierge ...
# INTENT_EXPIRES_DAYS=7
# FINDER_FEE=0
# CONCIERGE_QUERIES=wanted,looking for,need to buy,looking to buy,seeking
# CONCIERGE_MAX_BUYERS_PER_PASS=3
# CONCIERGE_SHORTLIST_SIZE=3

# ── Misc ──────────────────────────────────────────────────────
# PAID_TASKS_ENABLED=true
# LOG_LEVEL=info
