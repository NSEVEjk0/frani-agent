# ─────────────────────────────────────────────────────────────
#  frani-agent — example configuration
#  Copy to .env and edit. EVERY value has a safe default, so an
#  empty/absent .env runs a valid testnet2 agent out of the box.
#  (.env is gitignored — never commit real secrets.)
#  Made by CRYPTFRANI · Owner: Itachi
# ─────────────────────────────────────────────────────────────

# ── Core identity & network ──────────────────────────────────
# The nametag the agent claims (without the leading '@').
AGENT_NAME=frani-agent
# Unicity network to run against.
UNICITY_NETWORK=testnet2

# ── Standing watches (the metered half of discovery) ──────────
# A watch is a standing want: the agent re-runs it against the market
# and DMs an alert the first time a NEW intent matches. Alerts past a
# free allowance are drawn from prepaid credit, topped up by paying a
# payment request. Nothing here ever SENDS UCT — see below.
# Free alerts every account gets before it is ever asked for anything.
WATCH_FREE_ALERTS=3
# Price of one alert, in UCT.
WATCH_ALERT_PRICE=0.5
# How many alerts one top-up request buys.
WATCH_PACK_ALERTS=10

# ─────────────────────────────────────────────────────────────
#  Optional advanced settings (defaults shown) — safe to omit
# ─────────────────────────────────────────────────────────────

# ── Wallet storage / security ─────────────────────────────────
# WALLET_DIR=./wallet-data
# WALLET_FILE=wallet.json
# Encrypt the mnemonic at rest (recommended on a shared host). Empty = plaintext.
# WALLET_PASSWORD=

# ── Network endpoints (rarely changed) ────────────────────────
# COIN_SYMBOL=UCT
# WALLET_API_URL=https://wallet-api.unicity.network
# Public testnet2 oracle/aggregator key (NOT a secret; safe default baked in).
# ORACLE_API_KEY=

# ── Loop cadence (ms) — gentle by design for a shared VPS ─────
# FEED_POLL_MS=60000
# SEARCH_POLL_MS=90000
# RECEIVE_POLL_MS=45000
# Standing watches run slower than the concierge on purpose: a want that
# lasts days is not hurt by two minutes of latency.
# WATCH_POLL_MS=120000
# Backstop sweep for top-up requests nobody ever answered.
# BILL_SWEEP_MS=900000

# ── Economic safety rails ─────────────────────────────────────
# Global kill-switch: log intended actions but never touch the network/funds.
# DRY_RUN=false
# Whole-UCT mark below which the one-time bootstrap self-mint may fire.
# Nothing else consults it: this agent has NO outbound payment rail, so
# there is no spend for a floor to protect. There is no refund setting
# here for the same reason — prepaid credit carries over instead.
# MIN_BALANCE=1
# One-time capped self-mint on first run (no faucet on testnet2).
# SELF_MINT_ENABLED=true
# SELF_MINT_AMOUNT=100
# Politeness / anti-spam.
# MATCH_MIN_SCORE=0.72
# MAX_DMS_PER_HOUR=20
# MAX_ACTIONS_PER_HOUR=60

# ── Concierge (matchmaker) ────────────────────────────────────
# SERVICE_DESCRIPTION=Autonomous market concierge ...
# INTENT_EXPIRES_DAYS=7
# FINDER_FEE=0
# CONCIERGE_QUERIES=wanted,looking for,need to buy,looking to buy,seeking
# CONCIERGE_MAX_BUYERS_PER_PASS=3
# CONCIERGE_SHORTLIST_SIZE=3

# ── Watches (advanced) ────────────────────────────────────────
# WATCH_ENABLED=true
# WATCH_MAX_PER_ACCOUNT=3
# How long an unanswered top-up request is left open before it is
# treated exactly like a decline (nothing owed, watch paused).
# WATCH_BILL_TTL_HOURS=48
# WATCH_MAX_ALERTS_PER_PASS=3
# WATCH_MAX_QUEUED=10
# WATCH_EXPIRES_DAYS=14

# ── Misc ──────────────────────────────────────────────────────
# LOG_LEVEL=info
